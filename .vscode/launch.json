    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Hexo: server",
            "program": "${workspaceFolder}/node_modules/hexo/bin/hexo",
            "args": ["server"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "skipFiles": ["<node_internals>/**"]
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Hexo: generate",
            "program": "${workspaceFolder}/node_modules/hexo/bin/hexo",
            "args": ["generate"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "skipFiles": ["<node_internals>/**"]
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Hexo: clean",
            "program": "${workspaceFolder}/node_modules/hexo/bin/hexo",
            "args": ["clean"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "skipFiles": ["<node_internals>/**"]
        }
    ]
}
